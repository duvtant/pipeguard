# Copy to .env (git-ignored). Never commit real values: the repo is public.
DATABASE_URL=postgresql+psycopg://pipeguard:pipeguard@db:5432/pipeguard

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_TOOL_SECRET=

# Protects /api/admin/* and /api/testmode/*
ADMIN_TOKEN=

# Public URL (named Cloudflare tunnel) and tunnel token
PUBLIC_BASE_URL=https://pipeguard.blunelabs.com
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: only for the Custom LLM control in docs/techstack.md section 12.10
OPENROUTER_API_KEY=

# Paths inside the containers
MODEL_DIR=/app/ml/artifacts
SCENARIO_PATH=/app/infra/scenario.json

# Illustrative cost assumptions (stated openly in the pitch)
COST_BREAKDOWN=200000
COST_SERVICE=20000
COST_INSTRUMENT_CHECK=1000

# Engine and call guardrails
HORIZON_DAYS=14
CONFIRM_READINGS=3
MAX_CALLS_PER_TECH_PER_DAY=3

# Serve fixture JSON instead of real data (lets the dashboard be built before the engine exists)
MOCK_API=0

# Web: same origin through nginx. NEVER put secrets in VITE_ variables (they ship to the browser).
VITE_API_BASE_URL=/api

# Host port for the web container (default 8088)
WEB_PORT=8088
