# One image for api, engine and simulator (different commands in docker-compose.yml).
# Build ON EACH MACHINE (server x86, laptop may be arm64); do not copy a built image across architectures.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# libgomp1: LightGBM needs OpenMP on Linux (the engine crashes on import without it).
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core core
COPY api api
COPY engine engine
COPY simulator simulator
COPY ml ml
COPY infra infra
